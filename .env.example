# Only model selectors are passed to the controller, not provider credentials.
# Use exact selectors from `./start.sh bb omp models ls --json` after login.
# Leaving both empty is safe for a fresh OpenFactory with no enrolled projects.
OPENFACTORY_ASTRA_MODEL=
OPENFACTORY_FAST_MODEL=

# Optional private SAME HTTPS origin for BB root and OpenFactory Intake prefix.
# Set only after reviewing examples/intake-private-https.txt and policy intake.
# BB_APP_URL is documented by pinned BB0.47.1; persisted bb-app config values
# take precedence over this ambient environment value. No provider/auth change.
# OPENFACTORY_BB_APP_URL=https://openfactory.example-tailnet.ts.net
# When BB has that public origin but controller bb_url uses Docker DNS, opt in
# to an allowed HTTP Host without changing connection DNS or TLS identity:
# OPENFACTORY_BB_HOST_AUTHORITY=localhost:38886

# Stable Compose project name keeps volumes/state across restarts.
COMPOSE_PROJECT_NAME=openfactory
COMPOSE_FILE=compose.yaml

# Optional overlays: append only after creating the real files. No optional
# mount is enabled by default. Combine overlays using a colon, for example:
# COMPOSE_FILE=compose.yaml:deploy/compose.ssh.yaml:deploy/compose.openrouter.yaml
# Trusted checks needing internet: append deploy/compose.check-network.yaml.
# Without it checks have no external network route; preinstall dependencies.
# All host paths below should be absolute; quote dotenv values containing '#'.
# GIT_SSH_KEY_FILE=/absolute/path/to/dedicated_openfactory_key
# GIT_KNOWN_HOSTS_FILE=/absolute/path/to/verified_known_hosts
# GITHUB_TOKEN_FILE=/absolute/path/to/fine_grained_github_token
# OPENROUTER_API_KEY_FILE=/absolute/path/to/openrouter_api_key
# WEBHOOK_SECRET_FILE=/absolute/path/to/webhook_hmac_key
# Git/SSH/webhook secrets go only to openfactory; OpenRouter goes only to BB.
# Linux bind mounts retain host ownership: files must be readable by UID10001.
# Keep keys private and use a dedicated identity; do not chmod keys world-readable.

# Custom locations are starter environment variables, not dotenv settings:
# OPENFACTORY_ENV_FILE=/absolute/operator.env OPENFACTORY_CONFIG_FILE=/absolute/openfactory.yaml ./start.sh
# Existing config/env files and named volumes are never overwritten by start.sh.
# The starter mounts the entire dedicated config parent read-only at /config
# so atomic policy replacements and feature files remain visible. Custom file
# basenames are preserved inside /config; do not choose a parent with secrets
# or unrelated data. Direct Compose users can set OPENFACTORY_CONFIG_DIR and
# OPENFACTORY_CONFIG_BASENAME explicitly; the starter derives both from the file.
